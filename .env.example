# Local PostgreSQL container (fictional demo/test data only)
POSTGRES_DB=cms_quality_demo
POSTGRES_USER=cms_quality
POSTGRES_PASSWORD=cms_quality_dev
POSTGRES_PORT=5432

# FastAPI / SQLAlchemy. Override this in every deployed environment.
CMSQI_DATABASE_URL=postgresql+psycopg://cms_quality:cms_quality_dev@localhost:5432/cms_quality_demo
CMSQI_DEFAULT_FROM_YEAR=2025
CMSQI_DEFAULT_TO_YEAR=2026

# The seed command also requires this opt-in and a database name containing "demo".
CMSQI_ALLOW_DEMO_SEED=false

# Generate these values with: uv run python -m app.commands.generate_admin_credentials
# Keep the generated password hash and session secret out of version control.
CMSQI_ADMIN_USERNAME=
CMSQI_ADMIN_PASSWORD_HASH=
CMSQI_ADMIN_SESSION_SECRET=
# Use false only for local HTTP development. Deployed HTTPS environments must use true.
CMSQI_ADMIN_SESSION_SECURE=false

# Frontend: API is the default. Use demo only for the clearly labelled prototype fixtures.
VITE_DATA_MODE=api
# Leave blank in local Vite development so its /api proxy is used.
VITE_API_BASE_URL=
